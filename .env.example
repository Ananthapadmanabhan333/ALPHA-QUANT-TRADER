# ALPHA Quant Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets to source control.

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="ALPHA Quant"
VERSION=1.0.0
DEBUG=false
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS Configuration (JSON array of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database Configuration (TimescaleDB / PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_placeholder
POSTGRES_DB=alpha_quant

# Fully qualified connection URLs (defaults generated from components above if omitted)
# Async URL for FastAPI SQLAlchemy async sessions
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_placeholder@localhost:5432/alpha_quant
# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres_secure_placeholder@localhost:5432/alpha_quant

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
